# =====================================================================
# University Hostel Management System - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# =====================================================================

# Application Configuration
APP_NAME="University Hostel Management System"
APP_ENV=development
APP_DEBUG=true

# Database Configuration (Microsoft SQL Server 2025 / 2022 / 2019)
DB_SERVER=localhost
DB_DATABASE=university_hostel_db
DB_PORT=1433

# Authentication Mode:
# When DB_TRUSTED_CONNECTION=true, Windows Integrated Authentication is used
# When DB_TRUSTED_CONNECTION=false, DB_USER and DB_PASSWORD are used
DB_TRUSTED_CONNECTION=true
DB_TRUST_SERVER_CERTIFICATE=true

# SQL Server Authentication (used if DB_TRUSTED_CONNECTION=false)
DB_USER=hostel_app_user
DB_PASSWORD=YourStrongPasswordHere!

# Connection Pool & Timeout Settings
DB_CONNECTION_TIMEOUT=30
DB_MAX_POOL_SIZE=100

# File Storage Paths
ASSETS_PATH=Assets
ROOM_IMAGES_PATH=Assets/rooms
EVIDENCE_IMAGES_PATH=Assets/maintenance

